{
  "$schema": "https://dokploy.com/schema.json",
  "name": "kwanglim-chapel",
  "description": "Kwang-Lim Chapel Ministry Portal (Africa University) - single service: web pages, API, PWA, scheduler",
  "buildType": "dockerfile",
  "dockerfilePath": "./Dockerfile",
  "dockerContextPath": ".",
  "port": 80,
  "healthCheckPath": "/up",
  "restartPolicy": "unless-stopped",
  "mounts": [
    {
      "type": "volume",
      "name": "chapel_backend_storage",
      "mountPath": "/var/www/html/storage"
    }
  ]
}
