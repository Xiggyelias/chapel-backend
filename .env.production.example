APP_NAME="Kwang-Lim Chapel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Harare
APP_URL=https://ChapelCMapi.africau.co.zw

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL Database (chapel-postgres)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=your-postgres-host
DB_PORT=5432
DB_DATABASE=chapel_db
DB_USERNAME=chapel_user
DB_PASSWORD=change-me

# Session and Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database
# Runs the queue worker inside the container so emails are delivered in the background
ENABLE_QUEUE_WORKER=true

# Outgoing email (Gmail SMTP with an App Password: Google Account > Security > App passwords)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS="your-account@gmail.com"
MAIL_FROM_NAME="Kwang-Lim Chapel"
CHAPEL_EMAIL_NOTIFICATIONS=true

SEED_ON_DEPLOY=false

# Never enable the evaluator role switcher in production
DEMO_LOGIN_ENABLED=false

# Backups (php artisan chapel:backup runs daily at 02:00 via the scheduler)
CHAPEL_BACKUP_KEEP=14
# CHAPEL_BACKUP_SECONDARY_DIR=/mnt/offsite-backups
